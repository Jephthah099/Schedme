generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  Lecture
  Lab
  Clinical
  Study
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  subtitle     String   @default("")
  dailyTargetH Float    @default(8)
  createdAt    DateTime @default(now())

  activities  Activity[]
  goals       SubjectGoal[]
  deadlines   Deadline[]
  toggles     NotificationToggle[]
}

model Activity {
  id        String   @id @default(cuid())
  title     String
  place     String
  category  Category
  date      DateTime // calendar date this block is scheduled on (time component ignored)
  start     Int // minutes from midnight
  duration  Int // minutes
  done      Boolean  @default(false)
  remind    Int      @default(10) // minutes before start
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([userId])
}

model SubjectGoal {
  id        String @id @default(cuid())
  subject   String
  hoursGoal Float
  hoursDone Float  @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Deadline {
  id       String   @id @default(cuid())
  title    String
  subtitle String
  dueDate  DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationToggle {
  id      String  @id @default(cuid())
  key     String // before | drift | recap | digest
  enabled Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
